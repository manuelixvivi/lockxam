# EQUIGRADE x LOCKXAM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secrets accordingly.

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security & Secrets (ROTATE IN PRODUCTION)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_32_BYTES_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./equigrade_dev.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis & Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# Set to false in dev environment to allow http cookie sharing
COOKIE_SECURE=true

