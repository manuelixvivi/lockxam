# EQUIGRADE x LOCKXAM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secrets accordingly.

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Security & Secrets (ROTATE IN PRODUCTION)
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_32_BYTES_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./equigrade_dev.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Assessment & RAG Configuration (Milestone A6 & A7)
EQUIGRADE_AI_URL=http://localhost:5000
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
RAG_ENABLED=false
MAX_RAG_CONTEXT_TOKENS=1500
RAG_SIMILARITY_THRESHOLD=0.70
RAG_TOP_K=3

# Redis & Cache (Optional)
REDIS_URL=redis://localhost:6379/0

# Cookie Security
COOKIE_SECURE=false
