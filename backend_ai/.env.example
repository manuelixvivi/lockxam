# equigradeAI Environment Configuration
# ======================================

# Server Port & Host
PORT=5000
FLASK_DEBUG=True

# Groq LPU API Key (Get yours free at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Models
MODEL_NAME=llama-3.1-8b-instant
EVAL_MODEL_NAME=llama-3.3-70b-versatile

# Database URI (Optional for production persistence; leave default or empty for stateless)
DATABASE_URL=postgresql://equigrade:equigrade@localhost:5432/equigrade_db
